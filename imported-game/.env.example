# Replit: add these under Tools > Secrets. Replit's Postgres sets DATABASE_URL for you.
DATABASE_URL="postgresql://user:password@localhost:5432/lifesim"
# Long random string, e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET="change-me"
PORT=5173
NODE_ENV=production
# Optional: extra allowed browser origins (comma separated). Replit domains are automatic.
CLIENT_URL=""
# Optional: comma separated emails allowed to call admin routes.
ADMIN_EMAILS=""

# Optional: enable server-side AI resident conversations. Never put this key in a VITE_ variable.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
