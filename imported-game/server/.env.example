# Copy this to .env and fill in values
DATABASE_URL="postgresql://postgres:password@localhost:5432/lifesim?schema=public"
# REQUIRED in production (16+ random chars, e.g. `openssl rand -hex 32`). The server refuses to start without it when NODE_ENV=production.
JWT_SECRET="change-this-to-a-long-random-string-in-production"
PORT=3001
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Optional: enable server-side AI resident conversations. Never put this key in a VITE_ variable.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
