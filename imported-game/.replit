modules = ["nodejs-20", "postgresql-16"]
run = "npm run start"

[nix]
channel = "stable-24_05"

[env]
PORT = "5173"

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run db:push && npm run start"]

[[ports]]
localPort = 5173
externalPort = 80
